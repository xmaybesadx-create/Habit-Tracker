<Window x:Class="HabitTracker.HabitEditorWindow"
        xmlns:models="clr-namespace:HabitTracker.Models"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тип привычки" Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1F26">

    <Window.Resources>
        <!-- Базовый стиль кнопок типов -->
        <Style x:Key="TypeButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#333846"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Кнопки типов слева -->
        <StackPanel Grid.Column="0">

            <Button Content="Регулярная"
                    Command="{Binding SelectRegularCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TypeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedType}" Value="{x:Static models:HabitType.Regular}">
                                <Setter Property="Background" Value="#3F51B5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Вредная"
                    Command="{Binding SelectBadCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TypeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedType}" Value="{x:Static models:HabitType.Bad}">
                                <Setter Property="Background" Value="#E91E63"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Одноразовая"
                    Command="{Binding SelectOneTimeCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TypeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedType}" Value="{x:Static models:HabitType.OneTime}">
                                <Setter Property="Background" Value="#009688"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Создать"
                    Margin="0,20,0,0"
                    Height="40"
                    Background="#2196F3"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="CreateButton_Click"/>
        </StackPanel>

        <!-- Описание справа -->
        <Border Grid.Column="1"
                Margin="20,0,0,0"
                Background="#292D36"
                CornerRadius="12"
                Padding="16">
            <TextBlock Text="{Binding Description}"
                       Foreground="White"
                       TextWrapping="Wrap"
                       FontSize="14"/>
        </Border>
    </Grid>
</Window>
