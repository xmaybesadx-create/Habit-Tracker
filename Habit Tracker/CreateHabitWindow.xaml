<Window x:Class="HabitTracker.CreateHabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание привычки"
        Height="560" Width="430"
        WindowStartupLocation="CenterOwner"
        Background="#1E1F26">

    <!-- Весь контент на Canvas, как у тебя -->
    <Canvas Margin="20">

        <!-- НАЗВАНИЕ ПРИВЫЧКИ -->
        <TextBox x:Name="NameTextBox"
         Height="36"
         Width="390"
         Background="#1E1F26"
         Foreground="White"
         BorderBrush="Transparent"
         FontSize="16"
         VerticalContentAlignment="Center"
         Padding="10,0"
         Text="Название привычки . . ."
         Canvas.Left="0"
         Canvas.Top="0"
         GotFocus="NameTextBox_GotFocus"
         LostFocus="NameTextBox_LostFocus"/>

        <!-- ТИП ПОД НАЗВАНИЕМ (текст заполняем в коде) -->
        <TextBlock x:Name="TypeTextBlock"
                   Text="Тип: "
                   Foreground="#9FA4B5"
                   FontSize="12"
                   Canvas.Left="0"
                   Canvas.Top="40"/>

        <!-- БЛОК ИКОНКИ -->
        <Border x:Name="IconBlock"
                Background="#2F3846"
                CornerRadius="14"
                Padding="12"
                Width="390"
                Height="70"
                Canvas.Left="0"
                Canvas.Top="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Выбранная иконка слева -->
                <TextBlock x:Name="SelectedIconText"
                           Text="🙂"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="White"/>
                           

                <!-- Подписи по центру -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Иконка"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <TextBlock x:Name="IconSubtitleText"
                               Text="Нажми, чтобы выбрать значок"
                               Foreground="#9FA4B5"
                               FontSize="12"/>
                </StackPanel>

                <!-- Кнопка с 3 точками для выбора иконки -->
                <Button Grid.Column="2"
                        Content="⋯"
                        Width="32"
                        Height="32"
                        Background="#232733"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Click="SelectIconButton_Click"/>
            </Grid>
        </Border>

        <!-- БЛОК ЦВЕТА -->
        <Border x:Name="ColorBlock"
                Background="#2F3846"
                CornerRadius="14"
                Padding="12"
                Width="390"
                Height="70"
                Canvas.Left="0"
                Canvas.Top="150">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Превью выбранного цвета -->
                <Border x:Name="SelectedColorPreview"
                        Width="28"
                        Height="28"
                        CornerRadius="8"
                        Background="#2E7D32"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>

                <!-- Подписи -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Цвет"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <TextBlock x:Name="ColorSubtitleText"
                               Text="Нажми, чтобы выбрать цвет"
                               Foreground="#9FA4B5"
                               FontSize="12"/>
                </StackPanel>

                <!-- Кнопка с 3 точками для выбора цвета -->
                <Button Grid.Column="2"
                        Content="⋯"
                        Width="32"
                        Height="32"
                        Background="#232733"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Click="SelectColorButton_Click"/>
            </Grid>
        </Border>

        <!-- ТЕКСТ "КОГДА" -->
        <TextBlock Text="КОГДА..."
                   Foreground="#9FA4B5"
                   FontSize="12"
                   Canvas.Left="0"
                   Canvas.Top="230"/>

        <!-- СТРОКА С ДАТОЙ -->
        <Border x:Name="DateBlock"
                Background="#2F3846"
                CornerRadius="14"
                Padding="10"
                Width="390"
                Height="40"
                Canvas.Left="0"
                Canvas.Top="250">
            <Button x:Name="DateButton"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalContentAlignment="Left"
                    Foreground="White"
                    Click="DateButton_Click"/>
        </Border>

        <!-- ТЕКСТ "ВЫПОЛНИТЬ" -->
        <TextBlock Text="ВЫПОЛНИТЬ..."
                   Foreground="#9FA4B5"
                   FontSize="12"
                   Canvas.Left="0"
                   Canvas.Top="300"/>

        <!-- БЛОК ВРЕМЕНИ СУТОК (4 варианта) -->
        <Canvas x:Name="TimeBlock"
                Width="260"
                Height="80"
                Canvas.Left="0"
                Canvas.Top="320">

            <Grid Width="260" Height="80">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- НЕВАЖНО -->
                <Border x:Name="AnytimeBorder"
                        CornerRadius="18"
                        Background="#2F3846"
                        Margin="0,0,85,4"
                        Grid.Row="0"
                        Grid.Column="0" Grid.ColumnSpan="2">
                    <Button Content="Неважно"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="Transparent"
                            Click="TimeButton_Click"
                            Tag="Anytime"
                            Margin="10,0,10,0"/>
                </Border>

                <!-- УТРОМ -->
                <Border x:Name="MorningBorder"
                        CornerRadius="18"
                        Background="#2F3846"
                        Margin="88,0,-124,4"
                        Grid.Row="0"
                        Grid.Column="1">
                    <Button Content="Утром"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="Transparent"
                            Click="TimeButton_Click"
                            Tag="Morning"
                            Margin="17,-1,10,-2"/>
                </Border>

                <!-- ДНЁМ -->
                <Border x:Name="DayBorder"
                        CornerRadius="18"
                        Background="#2F3846"
                        Margin="0,4,85,0"
                        Grid.Row="1"
                        Grid.Column="0" Grid.ColumnSpan="2">
                    <Button Content="Днём"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="Transparent"
                            Click="TimeButton_Click"
                            Tag="Day"
                            Margin="18,0,19,0"/>
                </Border>

                <!-- ВЕЧЕРОМ -->
                <Border x:Name="EveningBorder"
                        CornerRadius="18"
                        Background="#2F3846"
                        Margin="88,4,-129,0"
                        Grid.Row="1"
                        Grid.Column="1">
                    <Button Content="Вечером"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="Transparent"
                            Click="TimeButton_Click"
                            Tag="Evening"
                            Margin="10,0,10,0"/>
                </Border>
            </Grid>
        </Canvas>

        <!-- КНОПКА "СОХРАНИТЬ" -->
        <Button x:Name="SaveButton"
                Content="Сохранить"
                Width="390"
                Height="46"
                Background="#2196F3"
                Foreground="White"
                BorderBrush="Transparent"
                Canvas.Top="448"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="SaveButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="16"
                            Padding="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</Window>