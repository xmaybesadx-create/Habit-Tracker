<Window x:Class="HabitTracker.HabitDaysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дни привычек"
        Height="480"
        Width="400"
        Background="#1E1F26"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- карточка 1 -->
            <RowDefinition Height="Auto"/>
            <!-- отступ -->
            <RowDefinition Height="Auto"/>
            <!-- карточка 2 -->
            <RowDefinition Height="*"/>
            <!-- заполнение -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель: стрелка назад + заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Width="32" Height="32"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    Cursor="Hand">
                <TextBlock Text="←" FontSize="18" />
            </Button>
            <TextBlock Text="Дни привычек"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </DockPanel>

        <!-- КАРТОЧКА 1: Определённые дни недели -->
        <Border Grid.Row="1"
                x:Name="DaysCardBorder"
                Background="#2F3846"
                CornerRadius="14"
                Padding="12"
                Cursor="Hand"
                MouseLeftButtonUp="DaysCardBorder_MouseLeftButtonUp">
            <StackPanel>
                <!-- Заголовок + подпись -->
                <StackPanel>
                    <TextBlock Text="Определённые дни недели"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DaysModeSubtitle"
                               Text="Нажми, чтобы выбрать дни недели"
                               Foreground="#9FA4B5"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Содержимое карточки 1 (дни недели) -->
                <StackPanel x:Name="DaysInnerPanel"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Выбери дни недели:"
                               Foreground="#9FA4B5"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <UniformGrid Columns="7">
                        <ToggleButton x:Name="MonButton"
                                      Content="П"
                                      Tag="0"
                                      Click="DayToggle_Click"/>
                        <ToggleButton x:Name="TueButton"
                                      Content="В"
                                      Tag="1"
                                      Click="DayToggle_Click"/>
                        <ToggleButton x:Name="WedButton"
                                      Content="С"
                                      Tag="2"
                                      Click="DayToggle_Click"/>
                        <ToggleButton x:Name="ThuButton"
                                      Content="Ч"
                                      Tag="3"
                                      Click="DayToggle_Click"/>
                        <ToggleButton x:Name="FriButton"
                                      Content="П"
                                      Tag="4"
                                      Click="DayToggle_Click"/>
                        <ToggleButton x:Name="SatButton"
                                      Content="С"
                                      Tag="5"
                                      Click="DayToggle_Click"/>
                        <ToggleButton x:Name="SunButton"
                                      Content="В"
                                      Tag="6"
                                      Click="DayToggle_Click"/>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Небольшой отступ между карточками -->
        <Border Grid.Row="2" Height="12" Background="Transparent"/>

        <!-- КАРТОЧКА 2: Х д. в месяц -->
        <Border Grid.Row="3"
                x:Name="MonthDaysCardBorder"
                Background="#2F3846"
                CornerRadius="14"
                Padding="12"
                Cursor="Hand"
                MouseLeftButtonUp="MonthDaysCardBorder_MouseLeftButtonUp">
            <StackPanel>
                <!-- Заголовок + подпись -->
                <StackPanel>
                    <TextBlock Text="Х д. в месяц"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="MonthDaysSubtitle"
                               Text="Нажми, чтобы выбрать количество дней"
                               Foreground="#9FA4B5"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Содержимое карточки 2 (числа 1–10) -->
                <StackPanel x:Name="MonthDaysInnerPanel"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Количество дней в месяц:"
                               Foreground="#9FA4B5"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    x:Name="MonthDaysButtonsPanel">
                            <Button Content="1" Tag="1" Click="NumberButton_Click"/>
                            <Button Content="2" Tag="2" Click="NumberButton_Click"/>
                            <Button Content="3" Tag="3" Click="NumberButton_Click"/>
                            <Button Content="4" Tag="4" Click="NumberButton_Click"/>
                            <Button Content="5" Tag="5" Click="NumberButton_Click"/>
                            <Button Content="6" Tag="6" Click="NumberButton_Click"/>
                            <Button Content="7" Tag="7" Click="NumberButton_Click"/>
                            <Button Content="8" Tag="8" Click="NumberButton_Click"/>
                            <Button Content="9" Tag="9" Click="NumberButton_Click"/>
                            <Button Content="10" Tag="10" Click="NumberButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>